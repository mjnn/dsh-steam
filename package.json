{
  "name": "dsh-steam",
  "version": "0.8.1",
  "description": "Steam toolkit for DeepSeek Harness: price/discount lookup, library and playtime, one-call install via the steam:// protocol, and a wishlist-ready discount watcher.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && node test/selftest.mjs",
    "release": "node tools/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjnn/dsh-steam.git"
  },
  "homepage": "https://github.com/mjnn/dsh-steam#readme",
  "bugs": {
    "url": "https://github.com/mjnn/dsh-steam/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "steam",
    "price",
    "wishlist"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
